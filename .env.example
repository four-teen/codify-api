# Production host settings.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://codifyapi.sksu-oracle.com
APP_TIMEZONE=Asia/Manila

# Replace the Vercel URL below if the final deployment uses a different domain.
FRONTEND_ORIGINS=https://codify-web-ruddy.vercel.app,http://localhost,http://127.0.0.1,http://localhost:5173

# Local-only alternative:
# APP_ENV=local
# APP_URL=http://localhost/codify-api
# FRONTEND_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Replace these database values with the database credentials from cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_cpanel_database
DB_USER=replace_with_cpanel_database_user
DB_PASS=replace_with_cpanel_database_password

BCRYPT_ROUNDS=12
# Use a private random value of at least 32 characters and keep it stable after deployment.
DEVICE_FINGERPRINT_KEY=replace-with-at-least-32-random-characters
# Optional persistent path used when DEVICE_FINGERPRINT_KEY is absent or still a placeholder.
# DEVICE_FINGERPRINT_KEY_FILE=/absolute/private/path/device-fingerprint.key
CODIFY_INITIAL_ADMIN_NAME="Codify Administrator"
CODIFY_INITIAL_ADMIN_USERNAME=administrator
CODIFY_INITIAL_ADMIN_EMAIL=administrator@example.test
CODIFY_INITIAL_ADMIN_PASSWORD=replace-with-a-long-temporary-password

# Sandboxed Python execution. Use a Judge0 CE instance controlled by your institution.
JUDGE0_ENABLED=false
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_LANGUAGE_ID=109
JUDGE0_CONNECT_TIMEOUT_SECONDS=5
JUDGE0_REQUEST_TIMEOUT_SECONDS=15
SYLLABUS_MAX_BYTES=10485760
CODE_RUN_RATE_LIMIT_PER_MINUTE=10
# Trusted local parser for initial rubric checks; submitted code is never executed.
PYTHON_ANALYZER_BINARY=python
