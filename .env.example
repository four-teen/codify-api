# Production host settings.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://codifyapi.sksu-oracle.com
APP_TIMEZONE=Asia/Manila

# Replace the Vercel URL below if the final deployment uses a different domain.
FRONTEND_ORIGINS=https://codify-web-ruddy.vercel.app,http://localhost,http://127.0.0.1,http://localhost:5173

# Local-only alternative:
# APP_ENV=local
# APP_URL=http://localhost/codify-api
# FRONTEND_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Replace these database values with the database credentials from cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_cpanel_database
DB_USER=replace_with_cpanel_database_user
DB_PASS=replace_with_cpanel_database_password

BCRYPT_ROUNDS=12
CODIFY_INITIAL_ADMIN_NAME="Codify Administrator"
CODIFY_INITIAL_ADMIN_USERNAME=administrator
CODIFY_INITIAL_ADMIN_EMAIL=administrator@example.test
CODIFY_INITIAL_ADMIN_PASSWORD=replace-with-a-long-temporary-password
