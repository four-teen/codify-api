APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Manila
FRONTEND_ORIGINS=https://codify.example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANEL_PREFIX_codify
DB_USER=CPANEL_PREFIX_codify_user
DB_PASS=replace-with-the-database-password

BCRYPT_ROUNDS=12
CODIFY_INITIAL_ADMIN_NAME="Codify Administrator"
CODIFY_INITIAL_ADMIN_USERNAME=administrator
CODIFY_INITIAL_ADMIN_EMAIL=administrator@example.com
CODIFY_INITIAL_ADMIN_PASSWORD=replace-with-a-long-temporary-password
